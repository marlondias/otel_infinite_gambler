{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch Console App",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/infinite_gambler.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "justMyCode": true,
            "internalConsoleOptions": "neverOpen"
        }
    ]
}